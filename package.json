{
  "name": "aula-clinica-ortega",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Aula Clínica — Semiología I: plataforma de estudio basada en las clases del Dr. Ortega",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check:content": "node scripts/check-content.mjs",
    "pdf": "node scripts/build-pdfs.mjs http://localhost:4791/aula-clinica-ortega/",
    "smoke": "node scripts/smoke-test.mjs",
    "tts": "node scripts/tts.mjs",
    "video:render": "remotion render video/src/index.ts"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.1.0",
    "@fontsource-variable/inter": "^5.1.0",
    "@remotion/player": "^4.0.541",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "remotion": "^4.0.541"
  },
  "devDependencies": {
    "@remotion/cli": "^4.0.541",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "puppeteer-core": "^23.10.0",
    "typescript": "~5.6.3",
    "vite": "^5.4.11"
  }
}
